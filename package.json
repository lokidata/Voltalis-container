{
  "name": "voltalis-bridge",
  "version": "1.6.0",
  "description": "Voltalis to Home Assistant bridge (container)",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm audit --omit=dev"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "axios-observable": "^2.1.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.9",
    "node-cron": "^4.6.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
